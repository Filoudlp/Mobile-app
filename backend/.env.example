# ---------------------------------------------------------------------------
# Configuration C-Lab — copiez en .env et renseignez les valeurs.
# En hébergement PaaS, définissez plutôt ces clés comme variables
# d'environnement du service.
# ---------------------------------------------------------------------------

# MongoDB — OBLIGATOIRE. Le serveur refuse de démarrer sans.
# Local   : mongodb://localhost:27017
# Atlas   : mongodb+srv://<user>:<motdepasse>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"
DB_NAME="clab"

# Clé de signature des sessions — OBLIGATOIRE en production.
# Si elle est absente, une clé éphémère est générée et TOUTES les sessions
# sautent au moindre redémarrage. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Stripe — facultatif. Laisser vide désactive le paiement (le reste marche).
# Le webhook exige une URL publique en HTTPS : impossible en local.
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
