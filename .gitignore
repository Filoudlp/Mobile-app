# Exception : le front compile DOIT etre versionne. Le Dockerfile le copie
# tel quel au lieu de lancer Metro dans le conteneur (Metro demande 1 a 2 Go
# de RAM, au-dela des quotas de build des offres d'entree de gamme).
# A regenerer avant chaque deploiement :  cd frontend && yarn expo export -p web
!frontend/dist/
!frontend/dist/**

# Journaux de dev.
*.log

# Exception : le modele de configuration doit etre versionne (il ne
# contient aucune valeur, seulement les noms de variables attendues).
!backend/.env.example

# Cache de build Metro (15 Mo, regenerable).
frontend/.metro-cache
